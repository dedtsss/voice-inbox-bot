[Unit]
Description=Voice Inbox Codex Subscription queue worker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/voice-inbox-bot/src/app/subscription_worker.py

[Service]
Type=oneshot
User=codex
Group=codex
EnvironmentFile=/opt/voice-inbox-bot/.env
Environment=PYTHONPATH=/opt/voice-inbox-bot/src
Environment=SUBSCRIPTION_CODEX_BINARY=/home/codex/.local/bin/codex
Environment=SUBSCRIPTION_CODEX_AUTH_FILE=/home/codex/.codex/auth.json
Environment=SUBSCRIPTION_WORKER_LOCK_FILE=/run/voice-inbox-subscription-worker/worker.lock
Environment=SUBSCRIPTION_WORKER_TMP_ROOT=/var/lib/voice-inbox-subscription-worker/tmp
Environment=SUBSCRIPTION_STT_CACHE_DIR=/var/cache/voice-inbox-subscription-worker/whisper
WorkingDirectory=/var/lib/voice-inbox-subscription-worker
ExecStart=/usr/bin/env GOOGLE_DRIVE_CREDENTIALS_FILE=/var/lib/voice-inbox-subscription-worker/secrets/google-drive-client.json GOOGLE_DRIVE_TOKEN_FILE=/var/lib/voice-inbox-subscription-worker/secrets/google-drive-token.json /var/lib/voice-inbox-subscription-worker/venv/bin/python -m app.subscription_worker --once --batch-size 1 --max-runtime 1800
TimeoutStartSec=35min
TimeoutStopSec=30s
KillMode=mixed
UMask=0077
RuntimeDirectory=voice-inbox-subscription-worker
RuntimeDirectoryMode=0700
StateDirectory=voice-inbox-subscription-worker
StateDirectoryMode=0700
CacheDirectory=voice-inbox-subscription-worker
CacheDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
ReadOnlyPaths=/opt/voice-inbox-bot
ReadWritePaths=/home/codex/.codex
ReadWritePaths=/var/lib/voice-inbox-subscription-worker
ReadWritePaths=/var/cache/voice-inbox-subscription-worker
ReadWritePaths=/run/voice-inbox-subscription-worker
InaccessiblePaths=/opt/voice-inbox-bot/.env
InaccessiblePaths=/opt/voice-inbox-bot/data
InaccessiblePaths=/home/codex/.ssh
InaccessiblePaths=/root
InaccessiblePaths=-/run/secrets
MemoryMax=2G
CPUQuota=150%
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
